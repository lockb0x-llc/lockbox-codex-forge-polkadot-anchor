{
  "name": "lockbox-codex-forge",
  "version": "1.0.0",
  "description": "Lockb0x Codex Forge Chrome Extension",
  "main": "background.js",
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"**/*.{js,json,md,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-manifest": "node build-manifest.js",
    "papi:add": "papi add dot -n polkadot",
    "papi:generate": "papi"
  },
  "devDependencies": {
    "eslint": "^9.38.0",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "vitest": "^4.0.6"
  },
  "dependencies": {
    "@polkadot-api/descriptors": "^0.0.1",
    "dotenv": "^17.2.3",
    "polkadot-api": "^1.20.1"
  }
}
